    "$fxv#0": "#cloud-config\r\nwrite_files:\r\n  - path: /opt/fw177-echo.py\r\n    permissions: '0755'\r\n    content: |\r\n      import concurrent.futures\r\n      import datetime\r\n      import json\r\n      import socket\r\n      import threading\r\n\r\n      lock = threading.Lock()\r\n\r\n      def receipt(protocol, port, remote, data):\r\n          with lock, open('/var/log/fw177-receipts.jsonl', 'a', buffering=1) as log:\r\n              log.write(json.dumps({\r\n                  'utc': datetime.datetime.now(datetime.timezone.utc).isoformat(),\r\n                  'protocol': protocol, 'port': port, 'remote': remote,\r\n                  'nonce': data.decode('ascii', errors='replace')\r\n              }, separators=(',', ':')) + '\\n')\r\n\r\n      def serve(protocol, port):\r\n          kind = socket.SOCK_STREAM if protocol == 'tcp' else socket.SOCK_DGRAM\r\n          with socket.socket(socket.AF_INET, kind) as listener:\r\n              listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)\r\n              listener.bind(('0.0.0.0', port))\r\n              if protocol == 'tcp':\r\n                  listener.listen(32)\r\n              while True:\r\n                  if protocol == 'tcp':\r\n                      peer, remote = listener.accept()\r\n                      with peer:\r\n                          peer.settimeout(4)\r\n                          try:\r\n                              data = peer.recv(256)\r\n                              receipt(protocol, port, remote, data)\r\n                              peer.sendall(data)\r\n                          except OSError:\r\n                              pass\r\n                  else:\r\n                      data, remote = listener.recvfrom(256)\r\n                      receipt(protocol, port, remote, data)\r\n                      listener.sendto(data, remote)\r\n\r\n      with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:\r\n          list(pool.map(lambda item: serve(*item),\r\n                        [('tcp', 18080), ('tcp', 18081), ('udp', 18082), ('udp', 18083)]))\r\n  - path: /etc/systemd/system/fw177-echo.service\r\n    content: |\r\n      [Unit]\r\n      Description=Synthetic Firewall qualification echo endpoints\r\n      After=network.target\r\n      [Service]\r\n      ExecStart=/usr/bin/python3 /opt/fw177-echo.py\r\n      Restart=on-failure\r\n      [Install]\r\n      WantedBy=multi-user.target\r\nruncmd:\r\n  - systemctl daemon-reload\r\n  - systemctl enable --now fw177-echo.service\r\n",
